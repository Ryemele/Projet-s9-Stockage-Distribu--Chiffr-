# Configuration du Gateway

# Base de données PostgreSQL
DATABASE_URL=postgresql://postgres:0000@localhost:5432/storage

# Secret pour JWT (à changer en production !)
JWT_SECRET_KEY=super-secret-key-change-in-production

# Service HSM (optionnel, pour plus tard)
HSM_URL=http://localhost:8000

# Port du gateway
GATEWAY_PORT=8080
